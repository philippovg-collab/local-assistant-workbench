COMPOSE_PROJECT_NAME=ragstudio

# Local HTTP entrypoint for the frontend nginx container.
# In production, expose HTTPS through the customer's reverse proxy and proxy to
# http://127.0.0.1:8080.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HTTP_PORT=8080
APP_CORS_ALLOWED_ORIGINS=https://your-domain.example

# Application admin account. Change the password before starting production-like compose.
APP_SECURITY_ADMIN_USERNAME=admin
APP_SECURITY_ADMIN_PASSWORD=

# Chat audit storage policy
APP_AUDIT_REDACTION_ENABLED=true
APP_AUDIT_STORE_RAW_LLM_RESPONSE=false
APP_AUDIT_STORE_REQUEST_MESSAGES=true
APP_AUDIT_MAX_STORED_TEXT_CHARS=12000

# PostgreSQL / pgvector
POSTGRES_DB=ragstudio
POSTGRES_USER=ragstudio
POSTGRES_PASSWORD=change-this-password

# Ollama models
APP_LLM_MODEL=qwen2.5:7b
APP_LLM_EXTRA_MODELS=
APP_LLM_TIMEOUT_SECONDS=600
APP_CHAT_EXECUTION_COMPATIBILITY_WAIT_TIMEOUT_SECONDS=30
APP_EMBEDDINGS_MODEL=nomic-embed-text
APP_EMBEDDINGS_TIMEOUT_SECONDS=60
APP_EMBEDDINGS_EXPECTED_DIMENSION=768

# OCR / scanned PDF support
APP_OCR_ENABLED=true
APP_OCR_BINARY_PATH=tesseract
APP_OCR_LANGUAGES=kaz+rus+eng
APP_OCR_TIMEOUT_SECONDS=20
APP_OCR_MAX_PAGES=12
APP_OCR_RENDER_DPI=200

# Upload limits
APP_MATERIALS_MAX_UPLOAD_BYTES=8388608
APP_MATERIALS_MAX_UPLOAD_REQUEST_BYTES=9437184
APP_MATERIALS_INDEXING_WORKER_COUNT=2

# Default production retrieval path. Keep PostgreSQL-only unless the search profile is enabled.
APP_RAG_LEXICAL_PROVIDER=postgres
APP_SEARCH_SYNC_ENABLED=false
APP_SEARCH_SYNC_INDEX_PREFIX=rag-chunks
SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200
SPRING_ELASTICSEARCH_USERNAME=
SPRING_ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# JVM sizing for the backend container.
BACKEND_JAVA_TOOL_OPTIONS=-Djava.awt.headless=true -XX:MaxRAMPercentage=75
