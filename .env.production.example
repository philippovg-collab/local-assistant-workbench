# Core app
POSTGRES_DB=ragstudio
POSTGRES_USER=ragstudio
POSTGRES_PASSWORD=change-me
FRONTEND_PORT=80

# Backend
BACKEND_JAVA_OPTS=-Xms512m -Xmx2g

# LLM and embeddings
# Recommended production setup for this repo:
# - frontend + backend + postgres on the main server
# - Ollama on the H200 server
# Point APP_LLM_BASE_URL to the private Ollama URL on H200.
APP_LLM_BASE_URL=http://10.0.0.20:11434
APP_LLM_MODEL=qwen3
APP_LLM_TIMEOUT_SECONDS=600
APP_EMBEDDINGS_MODEL=nomic-embed-text
APP_EMBEDDINGS_TIMEOUT_SECONDS=60

# Search rollout
APP_SEARCH_SYNC_ENABLED=false
APP_SEARCH_SYNC_INDEX_VERSION=v2
APP_RAG_LEXICAL_PROVIDER=postgres
SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200

# OCR
APP_OCR_ENABLED=false
APP_OCR_BINARY_PATH=tesseract
