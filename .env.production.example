# Core app
POSTGRES_DB=ragstudio
POSTGRES_USER=ragstudio
# Required in DEPLOY_ENV_PRODUCTION: POSTGRES_PASSWORD
FRONTEND_PORT=8088
BACKEND_IMAGE=ghcr.io/kazinsys-ai/rag-backend:latest
FRONTEND_IMAGE=ghcr.io/kazinsys-ai/rag-frontend:latest

# Backend
BACKEND_JAVA_OPTS="-Xms512m -Xmx2g"

# External AI gateway
# The backend talks to an already deployed OpenAI-compatible gateway.
# Do not deploy Ollama as part of the production stack.
APP_LLM_BASE_URL=http://10.9.120.3:8000
APP_LLM_API_KEY=EMPTY
APP_LLM_MODEL=qwen
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_PROVIDER_SECRET_KEY=change-this-long-random-secret
APP_EMBEDDINGS_BASE_URL=http://10.9.120.3:8000
APP_EMBEDDINGS_API_KEY=EMPTY
APP_EMBEDDINGS_MODEL=nomic-embed-text
APP_EMBEDDINGS_TIMEOUT_SECONDS=60
APP_EMBEDDINGS_EXPECTED_DIMENSION=768

# Context Manager rollout. Keep default-off until release proof is green.
APP_CONTEXT_ENABLED=false
APP_CONTEXT_CONVERSATIONS_ENABLED=false
APP_CONTEXT_HISTORY_ENABLED=false
APP_CONTEXT_STICKY_STATE_ENABLED=false
APP_CONTEXT_RETRIEVAL_QUERY_RESOLUTION_ENABLED=false
APP_CONTEXT_SUMMARY_ENABLED=false
APP_CONTEXT_LONG_TERM_MEMORY_ENABLED=false
APP_CONTEXT_MAX_RECENT_TURNS=6
APP_CONTEXT_MAX_HISTORY_TOKENS=2000
APP_CONTEXT_SUMMARY_REFRESH_TURNS=6
APP_CONTEXT_SUMMARY_MAX_INPUT_TURNS=12
APP_CONTEXT_SUMMARY_MAX_OUTPUT_CHARS=2500
APP_CONTEXT_SUMMARY_MAX_FACTS=12
APP_CONTEXT_SUMMARY_MAX_ACTIVE_ENTITIES=20
APP_CONTEXT_SUMMARY_MAX_SOURCE_REFS=20
APP_CONTEXT_SUMMARY_MAX_ATTEMPTS=3
APP_CONTEXT_SUMMARY_RETRY_BASE_SECONDS=30
APP_CONTEXT_SUMMARY_RETRY_MAX_SECONDS=300
APP_CONTEXT_MEMORY_EXTRACTION_LEASE_SECONDS=120
APP_CONTEXT_MEMORY_EXTRACTION_MAX_ATTEMPTS=3
APP_CONTEXT_MEMORY_EXTRACTION_RETRY_BASE_SECONDS=30
APP_CONTEXT_MEMORY_EXTRACTION_RETRY_MAX_SECONDS=300
APP_CONTEXT_MEMORY_EXTRACTION_WORKER_COUNT=1
APP_CONTEXT_MEMORY_EXTRACTION_DRAIN_MAX_JOBS=50
APP_CONTEXT_MEMORY_SELECTION_LIMIT=8
APP_CONTEXT_RETENTION_ENABLED=true
APP_CONTEXT_RETENTION_SNAPSHOT_DAYS=30
APP_CONTEXT_RETENTION_SUMMARY_JOB_DAYS=14
APP_CONTEXT_RETENTION_MEMORY_REJECTED_DAYS=30
APP_CONTEXT_RETENTION_MEMORY_DELETED_DAYS=30
APP_CONTEXT_RETENTION_MEMORY_JOB_DAYS=14
APP_CONTEXT_RETENTION_DELETED_CONVERSATION_DAYS=30
APP_CONTEXT_RETENTION_EMPTY_CONVERSATION_DAYS=7
APP_CONTEXT_RETENTION_KEEP_LATEST_SNAPSHOTS_PER_CONVERSATION=5
APP_CONTEXT_RETENTION_BATCH_SIZE=500

# Search rollout
APP_SEARCH_SYNC_ENABLED=false
APP_SEARCH_SYNC_INDEX_VERSION=v3
APP_RAG_LEXICAL_PROVIDER=postgres
SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200

# OCR
APP_OCR_ENABLED=false
APP_OCR_BINARY_PATH=tesseract

# Deployment preflight strictness
APP_SECURITY_ADMIN_USERNAME=admin
# Required in DEPLOY_ENV_PRODUCTION: APP_SECURITY_ADMIN_PASSWORD
PREFLIGHT_REQUIRE_LLM=true
PREFLIGHT_REQUIRE_EMBEDDINGS=false
