# Core app
POSTGRES_DB=ragstudio
POSTGRES_USER=ragstudio
POSTGRES_PASSWORD=change-me
FRONTEND_PORT=8088
BACKEND_IMAGE=ghcr.io/kazinsys-ai/rag-backend:latest
FRONTEND_IMAGE=ghcr.io/kazinsys-ai/rag-frontend:latest

# Backend
BACKEND_JAVA_OPTS="-Xms512m -Xmx2g"

# External AI gateway
# The backend talks to an already deployed OpenAI-compatible gateway.
# Do not deploy Ollama as part of the production stack.
APP_LLM_BASE_URL=http://10.9.120.3:8000
APP_LLM_API_KEY=EMPTY
APP_LLM_MODEL=qwen
APP_LLM_TIMEOUT_SECONDS=600
APP_EMBEDDINGS_BASE_URL=http://10.9.120.3:8000
APP_EMBEDDINGS_API_KEY=EMPTY
APP_EMBEDDINGS_MODEL=nomic-embed-text
APP_EMBEDDINGS_TIMEOUT_SECONDS=60
APP_EMBEDDINGS_EXPECTED_DIMENSION=768

# Search rollout
APP_SEARCH_SYNC_ENABLED=false
APP_SEARCH_SYNC_INDEX_VERSION=v2
APP_RAG_LEXICAL_PROVIDER=postgres
SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200

# OCR
APP_OCR_ENABLED=false
APP_OCR_BINARY_PATH=tesseract

# Deployment preflight strictness
APP_SECURITY_ADMIN_USERNAME=admin
APP_SECURITY_ADMIN_PASSWORD=change-me-admin
PREFLIGHT_REQUIRE_LLM=true
PREFLIGHT_REQUIRE_EMBEDDINGS=false
